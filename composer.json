{
    "name": "silarhi/cfonb-parser",
    "description": "A PHP parser for CFONB 120 and 240 bank files (statements and transfers), with zero dependencies",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "cfonb",
        "parser",
        "etebac",
        "bank",
        "bank-statement",
        "cfonb120",
        "cfonb240",
        "ebics"
    ],
    "authors": [
        {
            "name": "SILARHI",
            "email": "hello@silarhi.fr"
        }
    ],
    "homepage": "https://cfonb-parser.silarhi.dev",
    "support": {
        "issues": "https://github.com/silarhi/cfonb-parser/issues",
        "source": "https://github.com/silarhi/cfonb-parser",
        "docs": "https://cfonb-parser.silarhi.dev"
    },
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.11.1",
        "ergebnis/composer-normalize": "^2.58.0",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-strict-rules": "^2.1.2",
        "phpunit/phpunit": "^11.5.58 || ^12.5.38 || ^13.4.1",
        "rector/rector": "^2.9.2",
        "rector/swiss-knife": "^2.7.0",
        "vimeo/psalm": "^5.26.1 || ^6.21.2 || ^7.0.0"
    },
    "autoload": {
        "psr-4": {
            "Silarhi\\Cfonb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Silarhi\\Cfonb\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "block-insecure": false
        },
        "bump-after-update": "dev",
        "platform": {
            "php": "8.2.31"
        },
        "sort-packages": true
    }
}
